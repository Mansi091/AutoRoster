# Clerk backend authentication
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
# Optional PEM public key for local JWT verification.
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# Supabase private roster history (backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_side_service_role_key
SUPABASE_ROSTER_BUCKET=roster-history

# Location providers
GOOGLE_MAPS_API_KEY=replace_with_google_places_key
GEOAPIFY_API_KEY=replace_with_geoapify_key
LOCATIONIQ_API_KEY=replace_with_locationiq_key
# Optional pickup-name text cleanup
GEMINI_API_KEY=

# Route planning defaults; adjust to the actual operating roster
BUS_CAPACITY=32
TARGET_RIDE_TIME_MINUTES=60
MAX_RIDE_TIME_MINUTES=70
STOP_DWELL_MINUTES=1.5
BOARDING_SECONDS_PER_PASSENGER=0
ARRIVAL_BUFFER_MINUTES=10
PICKUP_MERGE_RADIUS_METERS=400
MAX_SERVICE_RADIUS_KM=50
ROUTE_SOLVER_TIME_LIMIT_SECONDS=30
SERVICE_AREA_LAT_MIN=17.9
SERVICE_AREA_LAT_MAX=19.2
SERVICE_AREA_LON_MIN=73.1
SERVICE_AREA_LON_MAX=74.6
SHIFT_A_ARRIVAL_DEADLINE=06:40
SHIFT_B_ARRIVAL_DEADLINE=15:10
SHIFT_C_ARRIVAL_DEADLINE=23:35

# OSRM endpoint overrides (public routing endpoints are the defaults)
OSRM_TABLE_URL=https://router.project-osrm.org/table/v1/driving
OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving

# Comma-separated frontend origins allowed by FastAPI; add your deployed Vercel URL.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Advanced route planner controls
ROUTE_TIME_TOLERANCE_SEC=60.0
OSRM_ROUTE_CONTINUE_STRAIGHT=false
FEASIBILITY_SOURCE=table
PLAN_HISTORY_DIR=data/plan_history
KM_REGRESSION_TOLERANCE_PCT=5.0
KM_WEIGHT=0.05
PICKUP_WINDOW_HARD=70
PICKUP_WINDOW_SOFT=60

FACILITY_NAME=Mercedes-Benz India
FACILITY_LAT=18.7366
FACILITY_LON=73.8090

PLAN_HISTORY_MODE=use
SCENARIOS_FILE=data/scenarios.json
ROUTE_NEAR_LIMIT_SEC=120.0

# Background jobs (route planning and scenarios run as jobs; the API returns a job_id at once)
# SOLVER_SOLUTION_LIMIT is the reproducible search budget per strategy (same input -> same plan
# on any machine). JOB_SOLVER_TIME_LIMIT_SECONDS is only a safety cap per strategy; a search that
# stops on the cap is flagged reproducible=false in the result.
SOLVER_SOLUTION_LIMIT=500
JOB_SOLVER_TIME_LIMIT_SECONDS=60
# Shift solves in parallel per job (1 = inline, lowest memory). Jobs run one at a time by default.
JOB_SHIFT_POOL_SIZE=3
JOB_MAX_CONCURRENT=1
JOB_RESULT_TTL_SECONDS=3600

# Pickup stop memory (Supabase tables from supabase/migrations/20261111_pickup_stops.sql).
# Without Supabase the app falls back to its last local copy, then data/seed/stops_seed.json.
STOP_STORE_TTL_SECONDS=60
STOP_STORE_TIMEOUT_SECONDS=10
STOP_SAME_PLACE_METERS=50
