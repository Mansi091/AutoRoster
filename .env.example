# Clerk backend authentication
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
# Optional PEM public key for local JWT verification.
CLERK_JWT_KEY=
# Add the exact Vercel origin to both values in the Render service environment.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase private roster history (backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_side_service_role_key
SUPABASE_ROSTER_BUCKET=roster-history

# Location providers
GOOGLE_MAPS_API_KEY=replace_with_google_places_key
GEOAPIFY_API_KEY=replace_with_geoapify_key
LOCATIONIQ_API_KEY=replace_with_locationiq_key
# Optional pickup-name text cleanup
GEMINI_API_KEY=

# Route planning defaults; adjust to the actual operating roster
BUS_CAPACITY=32
TARGET_RIDE_TIME_MINUTES=60
MAX_RIDE_TIME_MINUTES=70
STOP_DWELL_MINUTES=1.5
BOARDING_SECONDS_PER_PASSENGER=0
ARRIVAL_BUFFER_MINUTES=10
PICKUP_MERGE_RADIUS_METERS=400
MAX_SERVICE_RADIUS_KM=50
ROUTE_SOLVER_TIME_LIMIT_SECONDS=30
SERVICE_AREA_LAT_MIN=17.9
SERVICE_AREA_LAT_MAX=19.2
SERVICE_AREA_LON_MIN=73.1
SERVICE_AREA_LON_MAX=74.6
SHIFT_A_ARRIVAL_DEADLINE=06:40
SHIFT_B_ARRIVAL_DEADLINE=15:10
SHIFT_C_ARRIVAL_DEADLINE=23:35

# OSRM endpoint overrides (public routing endpoints are the defaults)
OSRM_TABLE_URL=https://router.project-osrm.org/table/v1/driving
OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving
